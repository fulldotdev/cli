{
  "name": "fulldev",
  "version": "0.1.0",
  "description": "Use Fulldev products, such as the CMS, Connect and Scan, from the command line through their MCP servers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fulldotdev/cli.git"
  },
  "type": "module",
  "bin": {
    "fulldev": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "vp pack && chmod 644 dist/cli.mjs",
    "dev": "vp pack --watch",
    "check": "vp check && vp test && pnpm build && git diff --exit-code -- dist",
    "fix": "vp check --fix",
    "test": "vp test",
    "release": "changeset version && pnpm install --lockfile-only && pnpm build",
    "release:publish": "pnpm build && git diff --exit-code -- dist && changeset publish"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3",
    "vite-plus": "1.0.0"
  },
  "author": "Fulldev",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/fulldotdev/cli#readme",
  "bugs": {
    "url": "https://github.com/fulldotdev/cli/issues"
  },
  "keywords": [
    "fulldev",
    "cms",
    "connect",
    "scan",
    "mcp",
    "cli",
    "agent-skills"
  ]
}
